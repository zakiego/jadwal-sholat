{
	"name": "jadwal-sholat",
	"version": "1.0.0",
	"description": "Free prayer times for every Indonesian city (Kemenag method): website, JSON API, MCP server, iCal feeds and curl.",
	"private": true,
	"license": "MIT",
	"author": "Zakiego (https://github.com/zakiego)",
	"homepage": "https://sholat.zakiego.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zakiego/jadwal-sholat.git"
	},
	"bugs": "https://github.com/zakiego/jadwal-sholat/issues",
	"keywords": ["prayer-times", "jadwal-sholat", "indonesia", "kemenag", "mcp", "cloudflare-workers"],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.8.1",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "vite build",
		"build": "node scripts/og.mjs && vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"og": "node scripts/og.mjs",
		"validate": "tsx scripts/validate.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@cfworker/json-schema": "^4.1.6",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.71.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"tz-lookup": "^6.1.25",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@resvg/resvg-js": "^2.6.2",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"satori": "^0.63.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.159.0"
	}
